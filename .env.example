# Oracle database account. Use a dedicated account with read-only privileges.
ORACLE_USER=ORACLE_MCP_READONLY
ORACLE_PASSWORD=replace-me

# Either a direct connection string, for example db.example.com:1521/SERVICE_NAME,
# or an alias from tnsnames.ora, for example my_database_low.
ORACLE_CONNECT_STRING=your_tns_alias_low

# Required when ORACLE_CONNECT_STRING is a TNS alias supplied by an Oracle wallet.
# Leave both values empty for a direct host:port/service-name connection.
ORACLE_CONFIG_DIR=/secure/oracle-wallet
ORACLE_WALLET_LOCATION=/secure/oracle-wallet
ORACLE_WALLET_PASSWORD=

# Schema used when a tool request does not specify an owner.
ORACLE_DEFAULT_SCHEMA=APP_SCHEMA

# Oracle connection-pool bounds.
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=4

# MCP transport: stdio for a local MCP client, streamable-http for HTTP.
MCP_TRANSPORT=stdio

# HTTP listener settings. For Docker, use MCP_HOST=0.0.0.0.
MCP_HOST=127.0.0.1
MCP_PORT=8000
